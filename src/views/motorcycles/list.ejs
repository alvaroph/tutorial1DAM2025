<%- include('../partials/header', { title: 'Llista de motos' }) %>
  <h1>Llista de motos</h1>
  <a class="btn btn-primary mb-3" href="/motorcycles/new">Afegir moto</a>
  <ul class="list-group">
    <% motorcycles.forEach(moto => { %>
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <span>
          <strong><%= moto.name %></strong> - <%= moto.brand %> (<%= moto.cc %> cc)
          <% if (moto.Category) { %>
            [<%= moto.Category.name %>]
          <% } %>
        </span>
        <span>
          <a href="/motorcycles/<%= moto.id %>/edit" class="btn btn-warning">Editar</a>
          <a href="/motorcycles/<%= moto.id %>/delete" class="btn btn-danger">Eliminar</a>
        </span>
      </li>
    <% }) %>
  </ul>
<%- include('../partials/footer') %>